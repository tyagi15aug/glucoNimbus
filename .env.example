# Postgres (application data)
DATABASE_URL=postgresql://gluconimbus:gluconimbus@localhost:5432/gluconimbus

# LocalStack (AWS-compatible endpoint for S3 raw/processed archival)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_RAW_BUCKET=gluconimbus-raw
S3_PROCESSED_BUCKET=gluconimbus-processed

# LocalStack SQS (event-driven ingestion pipeline — see docs/adr/0008)
SQS_QUEUE_NAME=gluconimbus-ingest
SQS_DLQ_NAME=gluconimbus-ingest-dlq
# AWS_ACCOUNT_ID rarely needs overriding — LocalStack's default test
# account (000000000000) is what infrastructure/localstack/init creates
# queues under, and apps/web + apps/workers assume it by default.
# AWS_ACCOUNT_ID=000000000000

# Ingestion API the simulator publishes readings to
INGESTION_API_URL=http://localhost:3000/api/readings

# Phase 4 auth — JWT session signing secret (docs/adr/0012-auth.md).
# Generate a real one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-real-random-secret
