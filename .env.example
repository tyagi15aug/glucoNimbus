# Postgres (application data)
DATABASE_URL=postgresql://glucostream:glucostream@localhost:5432/glucostream

# LocalStack (AWS-compatible endpoint for S3 raw/processed archival)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_RAW_BUCKET=glucostream-raw
S3_PROCESSED_BUCKET=glucostream-processed

# Ingestion API the simulator publishes readings to
INGESTION_API_URL=http://localhost:3000/api/readings
